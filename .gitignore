# Run records: runs/batches/ holds PUBLIC stripped batch records and is committed.
# Everything identifying (participants, paths, events) stays in runs/_private/.
runs/_private/

# Local machine config (keep config.example.yaml in git; config.yaml is local).
# Comment this out if you want to version your active config.
config.yaml

# Per-install path overrides set from the dashboard UI.
runtime_settings.json

# External tool repos cloned by setup_tools.py (fetched from GitHub, not vendored).
tools/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# OS / editor
Thumbs.db
.DS_Store
.vscode/
.idea/
launcher-log.txt

# local agent session config (per-machine, not part of the program)
.claude/

# Local-only working material: plans, drafts, scratch notes, anything that is
# about building the tool rather than part of it. Plans do not go on GitHub.
_local/
